---
import { Picture } from 'astro:assets';
import type { Lang, Product } from '../data/content';
import { t } from '../data/content';

interface Props {
  product: Product;
  lang: Lang;
  lastCommit?: string;
}

const { product, lang, lastCommit } = Astro.props;
const s = t[lang];
const repoUrl = `https://github.com/exzimio/${product.repo}`;
const isPublic = product.access === 'public';
// Never wider than the capture itself: an upscaled screenshot is heavier and no sharper.
const widths = [...[480, 800, 1200].filter((w) => w < product.image.width), product.image.width];
const sizes = product.layout === 'wide' ? '(max-width: 1240px) 100vw, 1184px' : '(max-width: 820px) 100vw, 700px';
---

<section class:list={['poster', product.layout]} aria-labelledby={`p-${product.repo}`}>
  <div class="art">
    <Picture
      src={product.image}
      alt={product.imageAlt[lang]}
      formats={['avif', 'webp']}
      widths={widths}
      sizes={sizes}
      loading={product.layout === 'wide' ? 'eager' : 'lazy'}
      class="shot"
    />
  </div>
  <div class="copy">
    <p class="tagline">{product.tagline[lang]}</p>
    <h2 class:list={['ptitle', { red: product.redTitle }]} id={`p-${product.repo}`}>
      {product.titleLines.map((line) => <span>{line}</span>)}
    </h2>
    <p class="deck">{product.deck[lang]}</p>
    <div class="meta">
      <span class:list={['badge caps', { red: isPublic }]}>{isPublic ? s.publicSource : s.showcase}</span>
      <a class="caps" href={repoUrl}>github.com/exzimio/{product.repo}</a>
    </div>
    <p class="stack mono">{product.stack}</p>
    {lastCommit && <p class="commit mono">{s.lastCommit} {lastCommit}</p>}
  </div>
</section>

<style>
  .poster {
    padding: 72px 0;
    border-bottom: 2px solid var(--ink);
    display: grid;
    gap: 36px;
  }
  .poster :global(.shot) {
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }
  .tagline {
    font: italic 500 20px / 1.4 var(--text);
    color: var(--muted);
    margin: 0 0 6px;
    max-width: 52ch;
  }
  .ptitle {
    font: 400 clamp(60px, 15vw, 210px) / 0.84 var(--display);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 18px 0 22px;
  }
  .ptitle span {
    display: block;
  }
  .ptitle.red {
    color: var(--red);
  }
  .deck {
    max-width: 62ch;
    margin: 0 0 20px;
    font-size: 18px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 18px;
    align-items: center;
  }
  .badge {
    padding: 5px 8px 4px;
    border: 1.5px solid var(--ink);
    font-size: 11px;
  }
  .badge.red {
    border-color: var(--red);
    color: var(--red);
  }
  .stack {
    margin: 16px 0 0;
    font-size: 14px;
  }
  .commit {
    margin: 4px 0 0;
    font-size: 13px;
    color: var(--muted);
  }

  /* Wide: the capture first, the title under it, as a one-sheet. */
  .wide .art {
    order: 0;
  }

  /* Split: stacked title on the left, capture on the right. */
  @media (min-width: 821px) {
    /* Half a page wide: the title is sized to its column so a word never breaks. */
    .split .ptitle,
    .flip .ptitle {
      font-size: clamp(72px, 9.4vw, 128px);
    }
    .split {
      grid-template-columns: 5fr 7fr;
      align-items: end;
      gap: 48px;
    }
    .split .copy {
      order: -1;
    }
    .flip {
      grid-template-columns: 7fr 5fr;
      align-items: end;
      gap: 48px;
    }
  }
</style>
